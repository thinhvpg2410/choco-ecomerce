# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/choco_ecommerce"

# JWT
JWT_SECRET="choco-ecommerce-secret"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="choco-ecommerce-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_TTL_SECONDS=60
REDIS_KEY_PREFIX="choco:"
REDIS_ENABLED=true

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"